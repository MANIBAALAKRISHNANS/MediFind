# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the deployed web frontend.
# The native Android app (Kotlin, calls the API directly via Retrofit/OkHttp)
# doesn't send an Origin header, so it isn't affected by this — CORS only
# gates browser requests. Server refuses to boot in production without this set.
CORS_ORIGIN=https://your-frontend-domain.com

# ── Email / password reset ────────────────────────────────────────────────────
SUPPORT_EMAIL=medifindofficial@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
# FRONTEND_URL is used in reset-password email links.
# In production, set this to your Render/Railway backend URL (which serves /reset-password).
FRONTEND_URL=http://localhost:5000
